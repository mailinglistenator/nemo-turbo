[Unit]
Description=nemo-turbo: Instant Launch Daemon for Nemo File Manager
Documentation=https://github.com/mailinglistenator/nemo-turbo
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="NEMO_PERSIST=1"
ExecStart=/usr/bin/nemo --no-default-window
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
